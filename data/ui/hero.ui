<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name hero.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="resizable">False</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox" id="contents_hbox">
            <property name="spacing">6</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox" id="map_vbox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="hbox3">
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkBox" id="map_eventbox">
                        <child>
                          <object class="GtkDrawingArea" id="map_drawing_area"/>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="contents_vbox">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <child>
                  <object class="GtkNotebook">
                    <property name="focusable">1</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="items_vbox">
                            <property name="margin-top">6</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkScrolledWindow" id="treeview_scrolledwindow">
                                <property name="focusable">1</property>
                                <property name="height-request">100</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="vexpand">1</property>
                                <property name="width-request">450</property>
                                <child>
                                  <object class="GtkColumnView" id="item_treeview"/>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="production_buttons_hbox">
                                <property name="halign">center</property>
                                <property name="margin-bottom">6</property>
                                <property name="margin-end">6</property>
                                <property name="margin-start">6</property>
                                <property name="margin-top">6</property>
                                <property name="spacing">6</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="drop_button">
                                    <property name="focusable">1</property>
                                    <property name="halign">center</property>
                                    <property name="label" translatable="yes">Drop</property>
                                    <property name="tooltip-text" translatable="yes">Stop producing armies</property>
                                    <property name="use-underline">1</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="pick_up_button">
                                    <property name="focusable">1</property>
                                    <property name="halign">center</property>
                                    <property name="label" translatable="yes">Pick up</property>
                                    <property name="tooltip-text" translatable="yes">Buy a production capability</property>
                                    <property name="use-underline">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Items</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox">
                            <property name="margin-top">6</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkGrid">
                                <property name="column-spacing">24</property>
                                <property name="halign">baseline-fill</property>
                                <property name="hexpand">True</property>
                                <property name="margin-end">6</property>
                                <property name="margin-start">6</property>
                                <property name="row-spacing">12</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="hexpand">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Battle</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="battle_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Moves</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="moves_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="hexpand">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Strength</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="strength_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="hexpand">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Command</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="command_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">0</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Level</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="level_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Upkeep</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="upkeep_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">1</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="css-classes">att-box</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="css-classes">att-title</property>
                                        <property name="label" translatable="yes">Experience</property>
                                        <property name="valign">end</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="experience_label">
                                        <property name="css-classes">att-value-label</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">2</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="css-classes">att-box</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <property name="vexpand">1</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">att-title</property>
                                    <property name="label" translatable="yes">History</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScrolledWindow" id="events_scrolledwindow">
                                    <property name="focusable">1</property>
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="vexpand">1</property>
                                    <child>
                                      <object class="GtkColumnView" id="event_treeview"/>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Hero Details</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="prev_button">
                <property name="focusable">1</property>
                <property name="hexpand">1</property>
                <property name="label" translatable="yes">Previous Hero</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="next_button">
                <property name="focusable">1</property>
                <property name="hexpand">1</property>
                <property name="label" translatable="yes">Next Hero</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Close</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
