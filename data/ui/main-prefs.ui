<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name main-prefs.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="page-increment">10</property>
    <property name="page-size">10</property>
    <property name="step-increment">5</property>
    <property name="upper">110</property>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="resizable">0</property>
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="css-classes">setting_lone</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_label</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">Commentator</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_explain_label</property>
                    <property name="label" translatable="yes">Have the warlord tell you how you're doing</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">True</property>
                <property name="margin-end">10</property>
                <property name="margin-start">10</property>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="commentator_switch">
                <property name="halign">end</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="css-classes">setting_top</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_label</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">Music</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_explain_label</property>
                    <property name="halign">start</property>
                    <property name="label" translatable="yes">Play music in the background</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="music_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="css-classes">setting_bottom</property>
            <child>
              <object class="GtkLabel">
                <property name="css-classes">setting_label</property>
                <property name="halign">start</property>
                <property name="label" translatable="yes">Volume</property>
                <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkScale" id="volume_scale">
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="upper">100.0</property>
                    <property name="value">50.0</property>
                  </object>
                </property>
                <property name="hexpand">True</property>
                <property name="hexpand-set">True</property>
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="halign">end</property>
            <property name="margin-bottom">10</property>
            <property name="margin-end">10</property>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="halign">end</property>
                <property name="label">Close</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
