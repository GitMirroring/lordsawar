<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name preferences.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="page-increment">10</property>
    <property name="page-size">10</property>
    <property name="step-increment">5</property>
    <property name="upper">110</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="page-increment">100000</property>
    <property name="page-size">100000</property>
    <property name="step-increment">100000</property>
    <property name="upper">1000000</property>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="resizable">0</property>
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox" id="contents_vbox">
            <property name="orientation">vertical</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="focusable">1</property>
                <property name="height-request">200</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="players_vbox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox">
                    <property name="css-classes">setting_top</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="css-classes">setting_label</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Commentator</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="css-classes">setting_explain_label</property>
                            <property name="label" translatable="yes">Have the warlord tell you how you're doing</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="hexpand">True</property>
                        <property name="margin-end">10</property>
                        <property name="margin-start">10</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="commentator_switch">
                        <property name="halign">end</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="css-classes">setting_middle</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="css-classes">setting_label</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Music</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="css-classes">setting_explain_label</property>
                            <property name="halign">start</property>
                            <property name="label" translatable="yes">Play music in the background</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSwitch" id="play_music_switch">
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="css-classes">setting_middle</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="css-classes">setting_label</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">Volume</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="music_volume_scale">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="upper">100.0</property>
                            <property name="value">50.0</property>
                          </object>
                        </property>
                        <property name="hexpand">True</property>
                        <property name="hexpand-set">True</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="css-classes">setting_bottom</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="css-classes">setting_label</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">Movement Speed</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScale" id="speed_scale">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="upper">100.0</property>
                            <property name="value">50.0</property>
                          </object>
                        </property>
                        <property name="hexpand">True</property>
                        <property name="hexpand-set">True</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="game_options_button">
                <property name="focusable">1</property>
                <property name="label" translatable="yes">View Game Options</property>
                <property name="receives-default">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Close</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="liststore1">
    <columns>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">Netbook</col>
      </row>
      <row>
        <col id="0">Desktop</col>
      </row>
      <row>
        <col id="0">Large Screen</col>
      </row>
    </data>
  </object>
</interface>
