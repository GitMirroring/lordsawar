<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name report.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="resizable">False</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox" id="outer_hbox">
            <property name="spacing">24</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox" id="left_vbox">
                <property name="halign">center</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="map_eventbox">
                    <child>
                      <object class="GtkDrawingArea" id="map_drawing_area"/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="right_vbox">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkNotebook" id="report_notebook">
                    <property name="height-request">300</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="vbox1">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkLabel" id="label6">
                                <property name="label" translatable="yes">Number of armies each side owns</property>
                                <property name="margin-top">6</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="army_alignment">
                                <property name="margin-end">10</property>
                                <property name="margin-start">10</property>
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="army_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="label1">
                            <property name="label" translatable="yes">Army</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="vbox2">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkLabel" id="label7">
                                <property name="label" translatable="yes">Number of cities each side owns</property>
                                <property name="margin-top">6</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="city_alignment">
                                <property name="margin-end">10</property>
                                <property name="margin-start">10</property>
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="city_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="label2">
                            <property name="label" translatable="yes">City</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="vbox3">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkLabel" id="label8">
                                <property name="label" translatable="yes">Amount of gold each side possesses</property>
                                <property name="margin-top">6</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="gold_alignment">
                                <property name="margin-end">10</property>
                                <property name="margin-start">10</property>
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="gold_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="label3">
                            <property name="label" translatable="yes">Gold</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="vbox4">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkLabel" id="label9">
                                <property name="label" translatable="yes">Armies you produced this turn</property>
                                <property name="margin-top">6</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow" id="scrolledwindow1">
                                <property name="focusable">1</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="vexpand">1</property>
                                <child>
                                  <object class="GtkColumnView" id="treeview"/>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="production_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="label4">
                            <property name="label" translatable="yes">Production</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="vbox5">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkLabel" id="label10">
                                <property name="label" translatable="yes">Who is the most powerful nation</property>
                                <property name="margin-top">6</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="winning_alignment">
                                <property name="margin-end">10</property>
                                <property name="margin-start">10</property>
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="winning_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="label5">
                            <property name="label" translatable="yes">Winning</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Close</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
