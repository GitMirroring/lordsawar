<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name stack-tile-box.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="box">
    <property name="margin-top">6</property>
    <child>
      <object class="GtkBox" id="stack_info_container">
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox" id="stack_info_box">
            <property name="margin-bottom">3</property>
            <property name="margin-end">3</property>
            <property name="margin-start">3</property>
            <property name="margin-top">3</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="group_info_box">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkImage" id="terrain_image"/>
            </child>
            <child>
              <object class="GtkLabel" id="group_moves_label">
                <property name="label">##</property>
                <property name="valign">center</property>
                <attributes>
                  <attribute name="scale" value="1.2"/>
                </attributes>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="group_togglebutton">
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="label1">
                    <property name="label" translatable="yes">Grp</property>
                    <attributes>
                      <attribute name="scale" value="1.2"/>
                    </attributes>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
