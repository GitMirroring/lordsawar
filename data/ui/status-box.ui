<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name status-box.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="box">
    <property name="hexpand">True</property>
    <property name="vexpand">1</property>
    <child>
      <object class="GtkNotebook" id="info_notebook">
        <property name="hexpand">1</property>
        <property name="show-border">False</property>
        <property name="show-tabs">False</property>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="stack_info_container">
                <property name="hexpand">True</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox" id="stack_tile_box_container"/>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="label1">
                <property name="label">label1</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="stats_box">
                <property name="hexpand">True</property>
                <child>
                  <object class="GtkBox" id="cities_stats_hbox">
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage" id="cities_stats_image">
                        <property name="pixel-size">32</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="cities_stats_label">
                        <property name="halign">start</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="gold_stats_hbox">
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage" id="gold_stats_image">
                        <property name="pixel-size">32</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="gold_stats_label">
                        <property name="halign">start</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="income_stats_hbox">
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage" id="income_stats_image">
                        <property name="pixel-size">32</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="income_stats_label">
                        <property name="halign">start</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="upkeep_stats_hbox">
                    <property name="halign">center</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkImage" id="upkeep_stats_image">
                        <property name="pixel-size">32</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="upkeep_stats_label">
                        <property name="halign">start</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="label2">
                <property name="label">label2</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkNotebookPage">
            <property name="child">
              <object class="GtkBox" id="progress_box">
                <property name="hexpand">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="valign">start</property>
                <child>
                  <object class="GtkLabel" id="progress_status_label">
                    <property name="justify">center</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="tartan_box">
                    <property name="hexpand">True</property>
                  </object>
                </child>
              </object>
            </property>
            <property name="tab">
              <object class="GtkLabel" id="label3">
                <property name="label">label3</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
