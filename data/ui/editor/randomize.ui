<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.2 -->
<interface>
  <!-- interface-name editor-quit.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="dialog">
    <property name="child">
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox" id="contents_vbox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="vexpand">1</property>
                <child>
                  <object class="GtkGrid">
                    <property name="column-spacing">32</property>
                    <property name="row-spacing">32</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label">Cities</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="cities_button">
                            <property name="label">All</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="unnamed_cities_button">
                            <property name="label">Unnamed Cities</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">0</property>
                          <property name="column-span">1</property>
                          <property name="row">0</property>
                          <property name="row-span">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label">Ruins</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="ruins_button">
                            <property name="label">All</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="unnamed_ruins_button">
                            <property name="label">Unnamed Ruins</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="column-span">1</property>
                          <property name="row">0</property>
                          <property name="row-span">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label">Temples</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="temples_button">
                            <property name="label">All</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="unnamed_temples_button">
                            <property name="label">Unnamed Temples</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">0</property>
                          <property name="column-span">1</property>
                          <property name="row">1</property>
                          <property name="row-span">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">3</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="halign">start</property>
                            <property name="label">Signs</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="signs_button">
                            <property name="label">All</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="unnamed_signs_button">
                            <property name="label">Unnamed Signs</property>
                            <property name="margin-start">6</property>
                          </object>
                        </child>
                        <layout>
                          <property name="column">1</property>
                          <property name="column-span">1</property>
                          <property name="row">1</property>
                          <property name="row-span">1</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="status_label">
                    <property name="css-classes">status-label</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="dialog-action_area1">
                <property name="halign">end</property>
                <property name="margin-top">6</property>
                <property name="spacing">6</property>
                <property name="valign">end</property>
                <child>
                  <object class="GtkButton" id="cancel_button">
                    <property name="halign">center</property>
                    <property name="label" translatable="yes">Cancel</property>
                    <property name="margin-end">3</property>
                    <property name="margin-start">3</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="randomize_button">
                    <property name="label">Randomize</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <property name="title" translatable="yes">Randomize Objects</property>
  </object>
</interface>
