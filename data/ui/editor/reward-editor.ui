<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.2 -->
<interface>
  <!-- interface-name reward-editor.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="lower">1</property>
    <property name="page-increment">10</property>
    <property name="step-increment">1</property>
    <property name="upper">5000</property>
    <property name="value">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="lower">1</property>
    <property name="page-increment">10</property>
    <property name="step-increment">1</property>
    <property name="upper">8</property>
    <property name="value">1</property>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="child">
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkBox">
                <property name="css-classes">setting_lone</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_label</property>
                    <property name="label" translatable="yes">Type of Reward</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="reward_combobox">
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkNotebook" id="notebook">
                <property name="show-border">False</property>
                <property name="show-tabs">False</property>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_lone</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Number of Gold Pieces</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSpinButton" id="gold_spinbutton">
                                    <property name="adjustment">adjustment1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_lone</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Item</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="item_button"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_top</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Number of Allies</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSpinButton" id="num_allies_spinbutton">
                                    <property name="adjustment">adjustment2</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_bottom</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Army Type</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="ally_button"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_top</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">X Position</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSpinButton" id="map_x_spinbutton"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_middle</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Y Position</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSpinButton" id="map_y_spinbutton"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_middle</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Width</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSpinButton" id="map_width_spinbutton"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_middle</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Height</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkSpinButton" id="map_height_spinbutton"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_bottom</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">setting_label</property>
                                    <property name="halign">start</property>
                                    <property name="label">Name</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">setting_explain_label</property>
                                    <property name="halign">start</property>
                                    <property name="label">This name appears in the Sage Dialog</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkEntry" id="map_name_entry"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebookPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkBox">
                            <property name="css-classes">setting_lone</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="css-classes">setting_label</property>
                                <property name="halign">start</property>
                                <property name="label">Ruin</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">end</property>
                                <property name="hexpand">True</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkButton" id="hidden_ruin_button"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="dialog-action_area1">
                <property name="halign">end</property>
                <property name="margin-top">6</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkButton" id="random_button">
                    <property name="label">Random</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="clear_button">
                    <property name="focus-on-click">0</property>
                    <property name="focusable">1</property>
                    <property name="label" translatable="yes">Clear</property>
                    <property name="margin-end">3</property>
                    <property name="margin-start">3</property>
                    <property name="receives-default">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="close_button">
                    <property name="focusable">1</property>
                    <property name="halign">center</property>
                    <property name="label">Close</property>
                    <property name="use-underline">1</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <property name="destroy-with-parent">1</property>
    <property name="title" translatable="yes">Reward Details</property>
  </object>
</interface>
