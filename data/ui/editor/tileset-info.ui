<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.2 -->
<interface>
  <!-- interface-name tileset-info.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="page-increment">10</property>
    <property name="step-increment">1</property>
    <property name="upper">100</property>
    <property name="value">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="page-increment">10</property>
    <property name="step-increment">1</property>
    <property name="upper">256</property>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="title" translatable="yes">Tile Set Properties</property>
    <child>
      <object class="GtkBox" id="outer_vbox">
        <property name="hexpand">1</property>
        <property name="margin-bottom">10</property>
        <property name="margin-end">10</property>
        <property name="margin-start">10</property>
        <property name="margin-top">10</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="css-classes">setting_top</property>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_label</property>
                    <property name="label">Name</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkEntry" id="name_entry">
                        <property name="placeholder-text">Name...</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="css-classes">setting_middle</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="css-classes">setting_label</property>
                        <property name="halign">start</property>
                        <property name="label">Tile Size</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="css-classes">setting_explain_label</property>
                        <property name="label">How many pixels tall and wide each tile is.</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkSpinButton" id="size_spinbutton">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">1.0</property>
                            <property name="page-increment">10.0</property>
                            <property name="page-size">10.0</property>
                            <property name="step-increment">1.0</property>
                            <property name="upper">1000.0</property>
                            <property name="value">1.0</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="css-classes">setting_bottom</property>
                <child>
                  <object class="GtkLabel">
                    <property name="css-classes">setting_label</property>
                    <property name="label">Location</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="location_label">
                    <property name="ellipsize">middle</property>
                    <property name="halign">end</property>
                    <property name="hexpand">True</property>
                    <property name="max-width-chars">50</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="css-classes">setting_lone</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <child>
                  <object class="GtkStackSwitcher">
                    <property name="stack">stack</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="stack">
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="height-request">91</property>
                        <property name="margin-top">3</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="vexpand">True</property>
                            <child>
                              <object class="GtkTextView" id="description_textview"/>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="title">Description</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="margin-top">3</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="vexpand">True</property>
                            <child>
                              <object class="GtkTextView" id="copyright_textview"/>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="title">Copyright</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="margin-top">3</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="vexpand">True</property>
                            <child>
                              <object class="GtkTextView" id="license_textview"/>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="title">License</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="margin-top">3</property>
                        <property name="orientation">vertical</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkGrid">
                            <property name="column-spacing">18</property>
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label" translatable="yes">Tiles:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label" translatable="yes">Selector:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label" translatable="yes">Explosion:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label" translatable="yes">Tile Styles:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label" translatable="yes">Roads:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label" translatable="yes">Bridges:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="tiles_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">1</property>
                                    <property name="justify">fill</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="explosion_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">1</property>
                                    <property name="justify">fill</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="selector_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">1</property>
                                    <property name="justify">fill</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="tilestyles_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">1</property>
                                    <property name="justify">fill</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">3</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="roads_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">1</property>
                                    <property name="justify">fill</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">3</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="bridges_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">3</property>
                                  <property name="column-span">1</property>
                                  <property name="row">2</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Standing Stones:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="column-span">1</property>
                                  <property name="row">3</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Fog:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="column-span">1</property>
                                  <property name="row">3</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label">Flags:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="column-span">1</property>
                                  <property name="row">4</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label">Move Bonus:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">2</property>
                                  <property name="column-span">1</property>
                                  <property name="row">4</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="css-classes">status-label</property>
                                    <property name="label">Images:</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="column-span">1</property>
                                  <property name="row">5</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="stones_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="column-span">1</property>
                                  <property name="row">3</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="fog_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">3</property>
                                  <property name="column-span">1</property>
                                  <property name="row">3</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="flags_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="column-span">1</property>
                                  <property name="row">4</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="move_bonus_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">3</property>
                                  <property name="column-span">1</property>
                                  <property name="row">4</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel" id="images_label">
                                    <property name="css-classes">status-label</property>
                                    <property name="halign">end</property>
                                    <property name="hexpand">True</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="column-span">1</property>
                                  <property name="row">5</property>
                                  <property name="row-span">1</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="title">Statistics</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="hexpand">True</property>
            <child>
              <object class="GtkLabel" id="status_label">
                <property name="css-classes">status-label</property>
                <property name="halign">center</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="label" translatable="yes">Close</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
