<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.2 -->
<interface>
  <!-- interface-name game-lobby.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="modal">1</property>
    <property name="title" translatable="yes">Lobby</property>
    <child>
      <object class="GtkBox" id="dialog-vbox1">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkGrid">
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkBox" id="left_vbox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkBox" id="hbox3">
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkBox" id="map_eventbox">
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkDrawingArea" id="map_drawing_area">
                                <property name="halign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <layout>
                      <property name="column">0</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="right_vbox">
                    <property name="hexpand">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="width-request">450</property>
                    <child>
                      <object class="GtkBox" id="vbox9">
                        <property name="height-request">150</property>
                        <property name="hexpand">True</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkScrolledWindow" id="scrolledwindow1">
                            <property name="focusable">1</property>
                            <property name="hexpand">True</property>
                            <property name="hscrollbar-policy">never</property>
                            <property name="vexpand">1</property>
                            <child>
                              <object class="GtkColumnView" id="player_treeview">
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <layout>
                      <property name="column">1</property>
                      <property name="row">0</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox10">
                <property name="hexpand">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">3</property>
                <property name="vexpand">1</property>
                <property name="width-request">400</property>
                <child>
                  <object class="GtkBox" id="hbox2">
                    <property name="height-request">150</property>
                    <property name="spacing">3</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkScrolledWindow" id="chat_scrolledwindow">
                        <property name="child">
                          <object class="GtkTextView" id="chat_textview">
                            <property name="buffer">
                              <object class="GtkTextBuffer"/>
                            </property>
                            <property name="cursor-visible">False</property>
                            <property name="editable">False</property>
                            <property name="focusable">1</property>
                            <property name="wrap-mode">word</property>
                          </object>
                        </property>
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="hscrollbar-policy">never</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scrolledwindow2">
                        <property name="focusable">1</property>
                        <property name="width-request">125</property>
                        <child>
                          <object class="GtkColumnView" id="people_treeview"/>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox1">
                    <child>
                      <object class="GtkEntry" id="chat_entry">
                        <property name="focusable">1</property>
                        <property name="hexpand">1</property>
                        <property name="invisible-char">●</property>
                        <property name="placeholder-text">Send Message...</property>
                        <property name="primary-icon-activatable">0</property>
                        <property name="secondary-icon-activatable">0</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="control_all_button"/>
            </child>
            <child>
              <object class="GtkButton" id="show_options_button">
                <property name="focusable">1</property>
                <property name="label" translatable="yes">Game Options</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="take_control_button">
                <property name="label">Take Control</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="release_button">
                <property name="label">Release</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="halign">center</property>
                <property name="label" translatable="yes">Cancel</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="play_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Play</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
