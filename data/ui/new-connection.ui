<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.2 -->
<interface>
  <!-- interface-name new-connection.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="lower">1</property>
    <property name="page-increment">10</property>
    <property name="step-increment">1</property>
    <property name="upper">65535</property>
    <property name="value">14998</property>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="title" translatable="yes">New Connection</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox">
                <property name="css-classes">setting_top</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">True</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="css-classes">setting_label</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">Host</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="css-classes">setting_explain_label</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">Hostname or IP of remote computer</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="hostname_entry">
                    <property name="activates-default">1</property>
                    <property name="focusable">1</property>
                    <property name="hexpand">True</property>
                    <property name="invisible-char">●</property>
                    <property name="valign">center</property>
                    <property name="vexpand">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="css-classes">setting_bottom</property>
                <child>
                  <object class="GtkLabel">
                    <property name="halign">start</property>
                    <property name="hexpand">True</property>
                    <property name="label" translatable="yes">Port</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="port_spinbutton">
                    <property name="adjustment">adjustment1</property>
                    <property name="climb-rate">1</property>
                    <property name="focusable">1</property>
                    <property name="text" translatable="yes">14998</property>
                    <property name="valign">center</property>
                    <property name="value">14998</property>
                    <property name="vexpand">1</property>
                    <property name="width-request">150</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Cancel</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="connect_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Connect</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
