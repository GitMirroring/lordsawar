<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name history-report.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="adjustment1">
    <property name="lower">1</property>
    <property name="step-increment">1</property>
    <property name="upper">1</property>
    <property name="value">1</property>
  </object>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="resizable">False</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox" id="outer_hbox">
            <property name="spacing">24</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox" id="left_vbox">
                <property name="halign">center</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkBox" id="map_eventbox">
                    <child>
                      <object class="GtkDrawingArea" id="map_drawing_area"/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="right_vbox">
                <property name="hexpand">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="width-request">252</property>
                <child>
                  <object class="GtkNotebook" id="history_notebook">
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="city_box">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox" id="city_alignment">
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="city_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="city_tab_label">
                            <property name="label" translatable="yes">City</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="ruin_box">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox" id="ruin_alignment">
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="ruin_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="ruin_tab_label">
                            <property name="label" translatable="yes">Ruin</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="events_box">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkScrolledWindow" id="scrolledwindow1">
                                <property name="focusable">1</property>
                                <property name="vexpand">1</property>
                                <child>
                                  <object class="GtkColumnView" id="treeview"/>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="events_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="events_tab_label">
                            <property name="label" translatable="yes">Events</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="gold_box">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox" id="gold_alignment">
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="gold_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="gold_tab_label">
                            <property name="label" translatable="yes">Gold</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="child">
                          <object class="GtkBox" id="winner_box">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkBox" id="winner_alignment">
                                <property name="orientation">vertical</property>
                                <property name="vexpand">1</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="winner_label">
                                <property name="margin-bottom">3</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="tab">
                          <object class="GtkLabel" id="winners_tab_label">
                            <property name="label" translatable="yes">Winners</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScale" id="turn_scale">
                    <property name="adjustment">adjustment1</property>
                    <property name="digits">0</property>
                    <property name="draw-value">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="focusable">1</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">Close</property>
                <property name="receives-default">1</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
