<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.3 -->
<interface>
  <!-- interface-name city-defeated.ui -->
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="dialog">
    <property name="destroy-with-parent">1</property>
    <property name="title" translatable="yes">Victory!</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="margin-bottom">6</property>
        <property name="margin-end">6</property>
        <property name="margin-start">6</property>
        <property name="margin-top">6</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkBox" id="contents_vbox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkBox" id="image_hbox">
                <property name="vexpand">1</property>
                <child>
                  <object class="GtkBox" id="vbox1">
                    <property name="halign">center</property>
                    <property name="hexpand">1</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkPicture" id="picture"/>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label">
                <property name="vexpand">1</property>
                <property name="wrap">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="dialog-action_area1">
            <property name="halign">end</property>
            <property name="margin-top">6</property>
            <child>
              <object class="GtkButton" id="occupy_button">
                <property name="halign">center</property>
                <property name="label" translatable="yes">Occupy</property>
                <property name="margin-end">3</property>
                <property name="margin-start">3</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pillage_button">
                <property name="halign">center</property>
                <property name="label" translatable="yes">Pillage</property>
                <property name="margin-end">3</property>
                <property name="margin-start">3</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sack_button">
                <property name="halign">center</property>
                <property name="label" translatable="yes">Sack</property>
                <property name="margin-end">3</property>
                <property name="margin-start">3</property>
                <property name="use-underline">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="raze_button">
                <property name="halign">center</property>
                <property name="label" translatable="yes">Raze</property>
                <property name="margin-start">3</property>
                <property name="use-underline">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
